        "@typescript-eslint/parser": "^8.34.0",
        "chrome-devtools-mcp": "^0.13.0",
        "eslint": "^9.28.0",
        "eslint-plugin-astro": "^1.3.1",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "playwright": "^1.58.2",
        "prettier": "3.5.3",
        "prettier-plugin-astro": "^0.14.1",
        "puppeteer": "^24.12.1",
        "resume-cli": "^3.1.2",
        "sharp": "^0.34.2",
