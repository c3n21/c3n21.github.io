        "re-extract": "pnpm extract-linkedin-data && pnpm generate-resume",
        "generate-resume": "tsx scripts/node/generate-resume.ts",
        "update-resume": "pnpm scrape-linkedin && pnpm generate-resume",
        "validate-resume": "resume validate jsonresume.json",
        "view-raw-data": "cat linkedin-export/raw-data.json | jq .",
        "linkedin-login": "tsx scripts/node/linkedin-login-helper.ts"
    },
    "dependencies": {
        "@astrojs/check": "^0.9.4",
        "@builder.io/qwik": "^1.14.1",
        "@fontsource-variable/jetbrains-mono": "^5.2.6",
        "@lucide/astro": "^0.513.0",
        "@qwikdev/astro": "^0.8.0",
        "@tailwindcss/vite": "^4.1.8",
        "astro": "^5.9.2",
        "tailwind": "^4.0.0",
