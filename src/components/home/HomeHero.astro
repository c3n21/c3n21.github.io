---
import SectionLabel from '@/components/ui/SectionLabel.astro'
import ArrowLink from '@/components/ui/ArrowLink.astro'
import CvDownloadLink from '@/components/CvDownloadLink.astro'
import DossierMeta from '@/components/ui/DossierMeta.astro'
---

<section class="home-hero site-container">
  <div class="editorial-grid">
    <div class="home-hero__main">
      <SectionLabel label="Software Engineer / Milan, Italy" />
      <h1>I build software across the stack, and go deeper when systems get difficult.</h1>
      <p class="home-hero__lede">
        Software Engineer working across product development, backend systems,
        infrastructure and developer tooling.
      </p>
      <div class="home-hero__actions">
        <ArrowLink href="/work/">See my work</ArrowLink>
        <CvDownloadLink />
      </div>
    </div>

    <aside class="home-hero__meta" aria-label="Engineering focus">
      <DossierMeta
        items={[
          { label: "Focus", value: "Product / Backend / Platform" },
          { label: "Systems", value: "Linux / Nix / CI" },
          { label: "Mode", value: "End-to-end ownership" },
        ]}
      />
    </aside>
  </div>
</section>

<style>
  .home-hero {
    min-height: min(48rem, calc(100svh - 5rem));
    display: grid;
    align-items: center;
    padding-block: clamp(5rem, 12vh, 9rem);
  }

  .home-hero__main {
    grid-column: 1 / span 8;
  }

  .home-hero__meta {
    grid-column: 10 / -1;
    align-self: end;
  }

  .home-hero h1 {
    max-width: 13ch;
    margin: 1.25rem 0 1.5rem;
    font-size: clamp(3rem, 7vw, 6.8rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
    font-weight: 650;
    color: var(--text);
  }

  .home-hero__lede {
    max-width: 52ch;
    color: var(--text-muted);
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    line-height: 1.65;
    margin-bottom: 2rem;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: center;
  }

  @media (max-width: 48rem) {
    .home-hero {
      min-height: auto;
      padding-block: clamp(3rem, 8vh, 5rem);
    }

    .home-hero__main {
      grid-column: 1 / -1;
    }

    .home-hero__meta {
      grid-column: 1 / -1;
      margin-top: 3rem;
      align-self: start;
    }
  }
</style>
