---
import { getPublishedWriting } from '@/lib/content/writing'
import Card from '@/components/Card.astro'
import CardHeader from '@/components/CardHeader.astro'
import CardTitle from '@/components/CardTitle.astro'
import CardContent from '@/components/CardContent.astro'
import Badge from '@/components/Badge.astro'
import Anchor from '@/components/astro/Anchor.astro'

const publishedWriting = await getPublishedWriting()
const recentArticles = publishedWriting.slice(0, 3)

function formatDate(date: Date | string): string {
    const d = new Date(date)
    return d.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
    })
}
---

<section id="writing" class="py-16 md:py-24 border-t border-border/40">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-4">
            <div>
                <h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
                    Technical Writing
                </h2>
                <p class="mt-2 text-muted-foreground text-lg">
                    Articles on systems, Nix, backend engineering, and developer tooling.
                </p>
            </div>
            <div>
                <Anchor href="/writing/" variant="outline">
                    All articles &rarr;
                </Anchor>
            </div>
        </div>

        {
            recentArticles.length === 0 ? (
                <div class="rounded-lg border border-dashed border-border p-12 text-center">
                    <p class="text-lg font-medium text-foreground mb-1">
                        Writing coming soon
                    </p>
                    <p class="text-sm text-muted-foreground max-w-md mx-auto">
                        In-depth articles covering NixOS infrastructure, systems debugging, and software engineering trade-offs are on the way.
                    </p>
                </div>
            ) : (
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    {recentArticles.map((article) => (
                        <Card class="flex flex-col h-full hover:border-foreground/30 transition-colors">
                            <CardHeader>
                                <div class="text-xs text-muted-foreground font-mono mb-2">
                                    {formatDate(article.data.publishDate)}
                                </div>
                                <CardTitle class="text-xl">
                                    <a
                                        href={`/writing/${article.id}/`}
                                        class="hover:text-primary transition-colors story-link"
                                    >
                                        {article.data.title}
                                    </a>
                                </CardTitle>
                            </CardHeader>
                            <CardContent class="flex-1 flex flex-col justify-between space-y-4">
                                <p class="text-sm text-muted-foreground line-clamp-3">
                                    {article.data.description}
                                </p>
                                {article.data.tags && article.data.tags.length > 0 && (
                                    <div class="flex flex-wrap gap-1.5 pt-2">
                                        {article.data.tags.map((tag) => (
                                            <Badge variant="outline" class="text-xs font-mono">
                                                {tag}
                                            </Badge>
                                        ))}
                                    </div>
                                )}
                            </CardContent>
                        </Card>
                    ))}
                </div>
            )
        }
    </div>
</section>
