---
import { getPublishedWork } from '@/lib/content/work'
import WorkCard from '@/components/work/WorkCard.astro'
import SectionLabel from '@/components/ui/SectionLabel.astro'
import ArrowLink from '@/components/ui/ArrowLink.astro'

const publishedWork = await getPublishedWork()
const featuredItems = publishedWork.filter((item) => item.data.featured).slice(0, 3)
const itemsToDisplay = featuredItems.length > 0 ? featuredItems : publishedWork.slice(0, 3)
---

<section id="work" class="py-16 md:py-24 border-t border-border">
    <div class="site-container">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-4">
            <div>
                <SectionLabel label="Selected Work" />
                <h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl mt-3">
                    Featured Systems & Projects
                </h2>
                <p class="mt-2 text-muted-foreground text-lg">
                    Production systems, infrastructure, and engineering case studies.
                </p>
            </div>
            <div>
                <ArrowLink href="/work/">All work</ArrowLink>
            </div>
        </div>

        {
            itemsToDisplay.length === 0 ? (
                <div class="border border-dashed border-border p-12 text-center">
                    <p class="text-muted-foreground">
                        Case studies are currently being prepared. Check back soon or browse <a href="/work/" class="underline hover:text-foreground">all work</a>.
                    </p>
                </div>
            ) : (
                <div class="work-list">
                    {itemsToDisplay.map((item, i) => (
                        <WorkCard entry={item} index={i + 1} />
                    ))}
                </div>
            )
        }
    </div>
</section>
