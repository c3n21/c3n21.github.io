---
import cv from '@/cv.json'
import { formatDateRange } from '@/lib/resume'
import ArrowLink from '@/components/ui/ArrowLink.astro'

interface Props {
    class?: string
}

const { class: className = '' } = Astro.props

const RELATED_WORK: Record<string, string> = {
    'HRM Group': '/work/backend-authorization-service/',
    'Self-employed': '/work/open-source/',
}
---

<section class:list={['space-y-8', className]} aria-labelledby="experience-heading">
    <h2
        id="experience-heading"
        class="text-2xl font-bold tracking-tight text-foreground border-b border-border/60 pb-2"
    >
        Experience
    </h2>
    <div class="space-y-8">
        {
            cv.work.map((job) => {
                const dateRange = formatDateRange(job.startDate, job.endDate)
                const relatedWorkHref = RELATED_WORK[job.name]
                return (
                    <article class="experience-item break-inside-avoid space-y-2">
                        <header class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
                            <div>
                                <h3 class="text-lg font-semibold text-foreground">
                                    {job.position}
                                </h3>
                                <div class="text-sm font-medium text-primary">
                                    {job.url ? (
                                        <a
                                            href={job.url}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="hover:underline"
                                        >
                                            {job.name}
                                        </a>
                                    ) : (
                                        job.name
                                    )}
                                </div>
                            </div>
                            <span class="text-sm font-mono text-muted-foreground shrink-0">
                                {dateRange}
                            </span>
                        </header>

                        {job.highlights && job.highlights.length > 0 ? (
                            <ul class="list-disc pl-5 space-y-1.5 text-sm text-muted-foreground/90 leading-relaxed">
                                {job.highlights.map((highlight) => (
                                    <li>{highlight}</li>
                                ))}
                            </ul>
                        ) : job.summary ? (
                            <p class="text-sm text-muted-foreground/90 whitespace-pre-line leading-relaxed">
                                {job.summary}
                            </p>
                        ) : null}

                        {relatedWorkHref && (
                            <div class="pt-1 print:hidden">
                                <ArrowLink href={relatedWorkHref} class="text-xs text-primary font-mono">
                                    Related work
                                </ArrowLink>
                            </div>
                        )}
                    </article>
                )
            })
        }
    </div>
</section>
