---
import cv from '@/cv.json'
import { groupSkills } from '@/lib/resume'

interface Props {
    class?: string
}

const { class: className = '' } = Astro.props
const skillGroups = groupSkills(cv.skills)
---

<section class:list={['space-y-6', className]} aria-labelledby="skills-heading">
    <h2
        id="skills-heading"
        class="text-2xl font-bold tracking-tight text-foreground border-b border-border/60 pb-2"
    >
        Technical Skills
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {
            skillGroups.map((group) => (
                <div class="break-inside-avoid space-y-1.5">
                    <h3 class="text-sm font-semibold tracking-wider uppercase text-muted-foreground font-mono">
                        {group.category}
                    </h3>
                    <p class="text-sm text-foreground/90 leading-relaxed">
                        {group.skills.join(' · ')}
                    </p>
                </div>
            ))
        }
    </div>
</section>
