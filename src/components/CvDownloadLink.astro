---
import Anchor from '@/components/astro/Anchor.astro'
import type ComponentBaseProps from '@/components/astro/theme/types/ComponentBaseProps'

interface Props
    extends ComponentBaseProps,
        astroHTML.JSX.AnchorHTMLAttributes {
    fallbackToPrint?: boolean
}

const { href: _ignoredHref, fallbackToPrint = false, ...rest } = Astro.props

const cvLocation = import.meta.env.CV_LOCATION
const hasCvLocation =
    typeof cvLocation === 'string' && cvLocation.trim().length > 0

const href = hasCvLocation ? cvLocation.trim() : '/resume/'
const defaultLabel = hasCvLocation ? 'Download CV' : 'View resume'
---

{
    !hasCvLocation && fallbackToPrint ? (
        <button
            type="button"
            onclick="window.print()"
            class={`cursor-pointer ${rest.class ?? ''}`}
        >
            <slot>{defaultLabel}</slot>
        </button>
    ) : (
        <Anchor href={href} {...rest} download={hasCvLocation ? '' : undefined}>
            <slot>{defaultLabel}</slot>
        </Anchor>
    )
}

