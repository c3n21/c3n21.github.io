---
import ArrowLink from '@/components/ui/ArrowLink.astro'

interface Props {
    class?: string
    fallbackToPrint?: boolean
    variant?: string
    size?: string
}

const { class: className = '', fallbackToPrint = false } = Astro.props

const cvLocation = import.meta.env.CV_LOCATION
const hasCvLocation =
    typeof cvLocation === 'string' && cvLocation.trim().length > 0

const href = hasCvLocation ? cvLocation.trim() : '/ZhifanChen.pdf'
---

{
    !hasCvLocation && fallbackToPrint ? (
        <button
            type="button"
            onclick="window.print()"
            class={`cursor-pointer inline-flex items-center gap-1.5 ${className}`}
        >
            <slot>Download PDF CV</slot>
            <span aria-hidden="true">↓</span>
        </button>
    ) : (
        <ArrowLink
            href={href}
            kind="download"
            class={className}
            download={true}
        >
            <slot>Download CV</slot>
        </ArrowLink>
    )
}
