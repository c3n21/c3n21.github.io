---
import { Sun, Moon } from '@lucide/astro'
import Button from './Button.astro'
---

<Button
    variant="ghost"
    size="icon"
    class="hover-scale"
    id="theme-toggle"
    aria-label="Toggle theme"
>
    <Sun
        class="sun dark:hidden h-[1.2rem] w-[1.2rem] rotate-0 scale-100 transition-all dark:-rotate-88 dark:scale-0"
    />
    <Moon
        class="moon absolute h-[1.2rem] w-[1.2rem] rotate-90 scale-0 transition-all dark:rotate-0 dark:scale-100"
    />
    <span class="sr-only">Toggle theme</span>
</Button>

<script>
    const KEY = "portfolio-theme";
    const media = window.matchMedia("(prefers-color-scheme: dark)");

    function effectiveTheme() {
        const explicit = document.documentElement.dataset.theme;
        return explicit === "light" || explicit === "dark"
            ? explicit
            : media.matches ? "dark" : "light";
    }

    function setTheme(theme: string) {
        localStorage.setItem(KEY, theme);
        document.documentElement.dataset.theme = theme;
        document.documentElement.dataset.themeMode = "manual";
        if (theme === "dark") {
            document.documentElement.classList.add("dark");
        } else {
            document.documentElement.classList.remove("dark");
        }
    }

    function useSystemTheme() {
        localStorage.removeItem(KEY);
        delete document.documentElement.dataset.theme;
        document.documentElement.dataset.themeMode = "system";
        if (media.matches) {
            document.documentElement.classList.add("dark");
        } else {
            document.documentElement.classList.remove("dark");
        }
    }

    (window as unknown as { useSystemTheme: () => void }).useSystemTheme = useSystemTheme;

    function toggleTheme() {
        const current = effectiveTheme();
        const next = current === "dark" ? "light" : "dark";
        setTheme(next);
    }

    media.addEventListener("change", () => {
        if (document.documentElement.dataset.themeMode === "system") {
            if (media.matches) {
                document.documentElement.classList.add("dark");
            } else {
                document.documentElement.classList.remove("dark");
            }
            document.dispatchEvent(
                new CustomEvent("portfolio-theme-change", {
                    detail: { theme: effectiveTheme() },
                }),
            );
        }
    });

    document.querySelectorAll('#theme-toggle').forEach((toggler) => {
        toggler.addEventListener('click', toggleTheme);
    });
</script>
