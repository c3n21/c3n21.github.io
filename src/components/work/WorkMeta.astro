---
import Badge from '@/components/Badge.astro'
import type { CollectionEntry } from 'astro:content'
import type { WorkLink } from '@/lib/content/work'

export interface Props {
    entry?: CollectionEntry<'work'> | undefined
    kind?: string | undefined
    date?: Date | string | undefined
    endDate?: Date | string | undefined
    technologies?: string[] | undefined
    links?: WorkLink[] | undefined
    class?: string | undefined
}

const {
    entry,
    kind = entry?.data.kind ?? '',
    date = entry?.data.date ?? new Date(),
    endDate = entry?.data.endDate,
    technologies = entry?.data.technologies ?? [],
    links = entry?.data.links ?? [],
    class: className = '',
} = Astro.props

function formatDate(d: Date | string): string {
    const parsed = new Date(d)
    return parsed.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'short',
    })
}
---

<div class:list={['flex flex-col gap-4 text-sm', className]}>
    <div class="flex flex-wrap items-center gap-3">
        {
            kind && (
                <Badge variant="secondary" class="capitalize text-xs font-medium">
                    {kind}
                </Badge>
            )
        }
        <span class="text-xs text-muted-foreground font-mono">
            {formatDate(date)}
            {endDate ? ` – ${formatDate(endDate)}` : ''}
        </span>
    </div>

    {
        technologies && technologies.length > 0 && (
            <div class="flex flex-wrap gap-1.5 items-center">
                <span class="text-xs text-muted-foreground mr-1 font-mono">Stack:</span>
                {technologies.map((tech) => (
                    <Badge variant="outline" class="text-xs font-mono">
                        {tech}
                    </Badge>
                ))}
            </div>
        )
    }

    {
        links && links.length > 0 && (
            <div class="flex flex-wrap gap-3 items-center pt-1">
                {links.map((link) => (
                    <a
                        href={link.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1 text-xs font-medium text-primary hover:underline underline-offset-4"
                    >
                        <span>{link.label}</span>
                        <span aria-hidden="true">&rarr;</span>
                    </a>
                ))}
            </div>
        )
    }
</div>
