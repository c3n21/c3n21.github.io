---
import type { CollectionEntry } from 'astro:content'
import type { WorkLink } from '@/lib/content/work'
import ArrowLink from '@/components/ui/ArrowLink.astro'

export interface Props {
    entry?: CollectionEntry<'work'> | undefined
    kind?: string | undefined
    date?: Date | string | undefined
    endDate?: Date | string | undefined
    technologies?: string[] | undefined
    links?: WorkLink[] | undefined
    class?: string | undefined
}

const {
    entry,
    kind = entry?.data.kind ?? '',
    date = entry?.data.date ?? new Date(),
    endDate = entry?.data.endDate,
    technologies = entry?.data.technologies ?? [],
    links = entry?.data.links ?? [],
    class: className = '',
} = Astro.props

function formatDate(d: Date | string): string {
    const parsed = new Date(d)
    return parsed.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'short',
    })
}
---

<div class:list={['work-meta', className]}>
    <div class="work-meta__row">
        {
            kind && (
                <span class="work-meta__tag meta-text">
                    {kind}
                </span>
            )
        }
        <span class="work-meta__date meta-text">
            {formatDate(date)}
            {endDate ? ` – ${formatDate(endDate)}` : ''}
        </span>
    </div>

    {
        technologies && technologies.length > 0 && (
            <div class="work-meta__stack">
                <span class="meta-text work-meta__stack-label">Stack:</span>
                <ul class="work-meta__tech-list" aria-label="Technologies">
                    {technologies.map((tech: string) => (
                        <li class="work-meta__tech-item">{tech}</li>
                    ))}
                </ul>
            </div>
        )
    }

    {
        links && links.length > 0 && (
            <div class="work-meta__links">
                {links.map((link: WorkLink) => (
                    <ArrowLink href={link.url} kind="external">
                        {link.label}
                    </ArrowLink>
                ))}
            </div>
        )
    }
</div>

<style>
    .work-meta {
        display: grid;
        gap: 0.85rem;
        font-family: var(--font-mono);
        font-size: 0.8rem;
    }

    .work-meta__row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem;
    }

    .work-meta__tag {
        display: inline-block;
        padding: 0.15rem 0.5rem;
        border: 1px solid var(--border);
        border-radius: 2px;
        background: var(--surface);
        color: var(--text);
    }

    .work-meta__date {
        color: var(--text-muted);
    }

    .work-meta__stack {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.5rem;
    }

    .work-meta__stack-label {
        color: var(--text-muted);
    }

    .work-meta__tech-list {
        display: inline-flex;
        flex-wrap: wrap;
        gap: 0.35rem;
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .work-meta__tech-item {
        display: inline-block;
        font-size: 0.75rem;
        padding: 0.1rem 0.4rem;
        background: var(--surface-raised);
        border: 1px solid var(--border);
        border-radius: 2px;
        color: var(--text-muted);
    }

    .work-meta__links {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        padding-top: 0.25rem;
    }
</style>
