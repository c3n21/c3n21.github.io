---
import type { CollectionEntry } from 'astro:content'
import Card from '@/components/Card.astro'
import CardHeader from '@/components/CardHeader.astro'
import CardTitle from '@/components/CardTitle.astro'
import CardContent from '@/components/CardContent.astro'
import Badge from '@/components/Badge.astro'

export interface Props {
    entry: CollectionEntry<'work'>
    class?: string | undefined
}

const { entry, class: className = '' } = Astro.props
const { title, summary, kind, date, endDate, technologies, featured } =
    entry.data

function formatDate(d: Date | string): string {
    const parsed = new Date(d)
    return parsed.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'short',
    })
}
---

<Card
    class:list={[
        'flex flex-col h-full hover:border-foreground/30 transition-colors',
        className,
    ]}
>
    <CardHeader>
        <div class="flex items-center justify-between gap-2 mb-2">
            <div class="flex items-center gap-1.5">
                <Badge variant="secondary" class="capitalize text-xs font-medium">
                    {kind}
                </Badge>
                {
                    featured && (
                        <Badge
                            variant="outline"
                            class="text-xs text-primary border-primary/30"
                        >
                            Featured
                        </Badge>
                    )
                }
            </div>
            <span class="text-xs text-muted-foreground font-mono">
                {formatDate(date)}
                {endDate ? ` – ${formatDate(endDate)}` : ''}
            </span>
        </div>
        <CardTitle class="text-xl">
            <a
                href={`/work/${entry.id}/`}
                class="hover:text-primary transition-colors story-link"
            >
                {title}
            </a>
        </CardTitle>
    </CardHeader>
    <CardContent class="flex-1 flex flex-col justify-between space-y-4">
        <p class="text-sm text-muted-foreground line-clamp-3 leading-relaxed">
            {summary}
        </p>
        <div class="flex flex-wrap gap-1.5 pt-2">
            {
                technologies.slice(0, 4).map((tech) => (
                    <Badge variant="outline" class="text-xs font-mono">
                        {tech}
                    </Badge>
                ))
            }
            {
                technologies.length > 4 && (
                    <Badge variant="outline" class="text-xs font-mono">
                        +{technologies.length - 4}
                    </Badge>
                )
            }
        </div>
    </CardContent>
</Card>
