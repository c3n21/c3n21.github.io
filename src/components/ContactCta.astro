---
import ArrowLink from '@/components/ui/ArrowLink.astro'
---

<section class="contact-cta site-container" data-contact-cta>
    <div class="rule"></div>
    <div class="editorial-grid contact-cta__grid">
        <h2>Have an interesting engineering problem?</h2>
        <div class="contact-cta__copy">
            <p>I occasionally take on selected part-time projects.</p>
            <ArrowLink href="/contact/">Let's talk</ArrowLink>
        </div>
    </div>
</section>

<style>
    .contact-cta {
        padding-block: clamp(3rem, 6vw, 5rem);
    }

    .contact-cta__grid {
        align-items: baseline;
        gap: 2rem;
        margin-top: clamp(2rem, 4vw, 3.5rem);
    }

    .contact-cta h2 {
        grid-column: 1 / span 7;
        font-size: clamp(1.8rem, 3.2vw, 2.75rem);
        font-weight: 650;
        line-height: 1.15;
        letter-spacing: -0.03em;
        color: var(--text);
        margin: 0;
    }

    .contact-cta__copy {
        grid-column: 8 / -1;
        display: grid;
        gap: 1.25rem;
    }

    .contact-cta__copy p {
        color: var(--text-muted);
        font-size: 1.05rem;
        line-height: 1.6;
        margin: 0;
    }

    @media (max-width: 48rem) {
        .contact-cta h2,
        .contact-cta__copy {
            grid-column: 1 / -1;
        }
    }
</style>
