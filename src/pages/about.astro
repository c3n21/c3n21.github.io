---
import { Image } from 'astro:assets'
import SiteLayout from '@/layouts/SiteLayout.astro'
import SectionLabel from '@/components/ui/SectionLabel.astro'
import ArrowLink from '@/components/ui/ArrowLink.astro'
import me from '@/assets/images/me.jpg'

const title = 'About — Zhifan Chen'
const description =
    'Background, engineering philosophy, and technical focus of Zhifan Chen — Software Engineer focused on backend, platform, and infrastructure.'
---

<SiteLayout title={title} description={description}>
    <main id="main-content" class="py-12 md:py-20">
        <div class="site-container">
            <header class="mb-12 max-w-3xl">
                <SectionLabel label="Background & Focus" />
                <h1
                    class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl md:text-5xl mt-3 mb-4"
                >
                    About
                </h1>
                <p class="text-lg text-muted-foreground leading-relaxed">
                    Software engineer working across product development, backend systems, infrastructure, and developer tooling.
                </p>
            </header>

            <div class="about-grid">
                <div class="about-grid__media">
                    <figure class="about-portrait">
                        <Image
                            src={me}
                            alt="Portrait of Zhifan Chen"
                            widths={[480, 720, 960]}
                            sizes="(max-width: 768px) 100vw, 42vw"
                        />
                    </figure>
                </div>

                <div class="about-grid__prose prose-column space-y-6">
                    <section class="space-y-4">
                        <h2 class="text-xl font-bold tracking-tight text-foreground">
                            Engineering Philosophy
                        </h2>
                        <p class="text-muted-foreground leading-relaxed">
                            Over several years of building production applications, I have worked across the delivery lifecycle—from React and TypeScript client applications to backend services, database schemas, and Linux deployment environments. That broad exposure shaped how I approach software: prioritizing maintainability, testability, and operational simplicity over cleverness.
                        </p>
                        <p class="text-muted-foreground leading-relaxed">
                            My deepest technical curiosity centers on <strong>systems, developer tooling, and reproducibility</strong>. I believe environment discrepancies and developer friction are among the biggest drains on engineering velocity. By engineering declarative, reproducible workstations and continuous integration workflows with <strong>Nix and Linux</strong>, teams eliminate whole classes of "works on my machine" failures.
                        </p>
                    </section>

                    <section class="space-y-4 pt-4 border-t border-border">
                        <h2 class="text-xl font-bold tracking-tight text-foreground">
                            Debugging & Systems Investigation
                        </h2>
                        <p class="text-muted-foreground leading-relaxed">
                            When systems break, I go beneath high-level abstractions to find root causes. Whether diagnosing dynamic linker failures, memory leaks, transaction contention, or submitting upstream fixes to open-source tools, I look for enduring solutions that prevent recurrence.
                        </p>
                    </section>

                    <section class="space-y-4 pt-4 border-t border-border">
                        <h2 class="text-xl font-bold tracking-tight text-foreground">
                            Education & International Context
                        </h2>
                        <p class="text-muted-foreground leading-relaxed">
                            I am based in Milan, Italy, pursuing a BSc in Computer Science at Università degli Studi di Milano concurrently with professional practice. Fluent in English and Italian, with native Chinese, I am comfortable collaborating across distributed international teams and technical cultures.
                        </p>
                    </section>

                    <div class="pt-6 border-t border-border flex flex-wrap gap-6 items-center">
                        <ArrowLink href="/work/">See my work</ArrowLink>
                        <ArrowLink href="/resume/">View resume</ArrowLink>
                        <ArrowLink href="/contact/">Get in touch</ArrowLink>
                    </div>
                </div>
            </div>
        </div>
    </main>
</SiteLayout>

<style>
    .about-grid {
        display: grid;
        gap: 3rem;
        align-items: start;
    }

    @media (min-width: 56rem) {
        .about-grid {
            grid-template-columns: minmax(18rem, 24rem) 1fr;
            gap: 4rem;
        }
    }

    .about-portrait {
        margin: 0;
        border: 1px solid var(--border);
        background: var(--surface);
        overflow: hidden;
    }

    .about-portrait img {
        width: 100%;
        height: auto;
        display: block;
        aspect-ratio: 4 / 5;
        object-fit: cover;
    }
</style>
