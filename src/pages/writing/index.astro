---
import SiteLayout from '@/layouts/SiteLayout.astro'
import { getPublishedWriting } from '@/lib/content/writing'
import ArticleCard from '@/components/writing/ArticleCard.astro'
import SectionLabel from '@/components/ui/SectionLabel.astro'
import ArrowLink from '@/components/ui/ArrowLink.astro'

const title = 'Writing'
const description =
    'Technical articles, systems investigations, and engineering reflections on NixOS, reproducible workflows, and backend architecture.'

const articles = await getPublishedWriting()
---

<SiteLayout title={title} description={description}>
    <main id="main-content" class="py-12 md:py-20">
        <div class="site-container">
            <header class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-16">
                <div class="max-w-2xl">
                    <SectionLabel label="Engineering Notes & Architecture" />
                    <h1 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl md:text-5xl mt-3">
                        Writing
                    </h1>
                    <p class="text-lg text-muted-foreground leading-relaxed mt-4">
                        Technical investigations, reproducible build workflows, and lessons learned from production systems and open-source contributions.
                    </p>
                </div>
                <div>
                    <ArrowLink href="/rss.xml" kind="external">
                        RSS Feed
                    </ArrowLink>
                </div>
            </header>

            {
                articles.length > 0 ? (
                    <div class="articles-list">
                        {articles.map((entry) => (
                            <ArticleCard entry={entry} />
                        ))}
                    </div>
                ) : (
                    <div class="border border-dashed border-border p-12 text-center max-w-lg mx-auto">
                        <p class="meta-text mb-2">
                            Writing coming soon
                        </p>
                        <h2 class="text-xl font-semibold text-foreground mb-3">
                            No articles published yet
                        </h2>
                        <p class="text-sm text-muted-foreground leading-relaxed mb-6">
                            Deep dives into declarative NixOS infrastructure, systems debugging, and backend engineering trade-offs are currently being authored.
                        </p>
                        <ArrowLink href="/rss.xml" kind="external">
                            Subscribe via RSS
                        </ArrowLink>
                    </div>
                )
            }
        </div>
    </main>
</SiteLayout>
