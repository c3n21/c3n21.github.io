---
import SiteLayout from '@/layouts/SiteLayout.astro'
import SectionLabel from '@/components/ui/SectionLabel.astro'
import ArrowLink from '@/components/ui/ArrowLink.astro'
---

<SiteLayout
    title="404 — Page Not Found — Zhifan Chen"
    description="The page you're looking for isn't here."
    noindex={true}
>
    <main id="main-content" class="py-20 md:py-32">
        <div class="site-container max-w-2xl">
            <SectionLabel label="404 / NOT FOUND" />
            <h1
                class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-foreground mt-4 mb-4"
            >
                Page Not Found
            </h1>
            <p class="text-lg text-muted-foreground leading-relaxed mb-8">
                The page you're looking for isn't here.
            </p>
            <div class="flex items-center gap-6">
                <ArrowLink href="/">Back home</ArrowLink>
                <ArrowLink href="/work/">See my work</ArrowLink>
            </div>
        </div>
    </main>
</SiteLayout>
