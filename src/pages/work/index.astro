---
import SiteLayout from '@/layouts/SiteLayout.astro'
import WorkCard from '@/components/work/WorkCard.astro'
import SectionLabel from '@/components/ui/SectionLabel.astro'
import { getPublishedWork } from '@/lib/content/work'

const workEntries = await getPublishedWork()
const featuredEntries = workEntries.filter((e) => e.data.featured)
const otherEntries = workEntries.filter((e) => !e.data.featured)
---

<SiteLayout
    title="Engineering Work & Case Studies — Zhifan Chen"
    description="Production systems, infrastructure, and engineering case studies detailing problem context, technical decisions, and verifiable results."
>
    <main id="main-content" class="py-16 md:py-24">
        <div class="site-container">
            <header class="max-w-3xl mb-16">
                <SectionLabel label="Selected Case Studies & Systems" />
                <h1
                    class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl lg:text-5xl mt-3"
                >
                    Engineering Work & Case Studies
                </h1>
                <p class="mt-4 text-lg text-muted-foreground leading-relaxed">
                    Production systems, infrastructure, and technical investigations.
                    Each case study details the core problem, engineering constraints,
                    trade-offs evaluated, and verifiable outcomes.
                </p>
            </header>

            {
                workEntries.length === 0 ? (
                    <div class="border border-dashed border-border p-12 text-center">
                        <p class="text-muted-foreground">
                            No case studies are currently published. Check back soon for new engineering write-ups.
                        </p>
                    </div>
                ) : (
                    <div class="space-y-16">
                        {featuredEntries.length > 0 && (
                            <section aria-label="Featured engineering projects">
                                <div class="work-list">
                                    {featuredEntries.map((entry, i) => (
                                        <WorkCard entry={entry} index={i + 1} />
                                    ))}
                                </div>
                            </section>
                        )}

                        {otherEntries.length > 0 && (
                            <section aria-label="Additional engineering projects">
                                <div class="mb-6">
                                    <SectionLabel label="Additional Systems & Projects" />
                                </div>
                                <div class="work-list">
                                    {otherEntries.map((entry, i) => (
                                        <WorkCard
                                            entry={entry}
                                            compact={true}
                                            index={featuredEntries.length + i + 1}
                                        />
                                    ))}
                                </div>
                            </section>
                        )}
                    </div>
                )
            }
        </div>
    </main>
</SiteLayout>
