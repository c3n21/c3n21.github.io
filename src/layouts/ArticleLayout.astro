---
import type { CollectionEntry } from 'astro:content'
import SiteLayout from '@/layouts/SiteLayout.astro'
import SectionLabel from '@/components/ui/SectionLabel.astro'
import ArrowLink from '@/components/ui/ArrowLink.astro'

export interface Props {
    entry: CollectionEntry<'writing'>
}

const { entry } = Astro.props
const { title, description, publishDate, updatedDate, tags } = entry.data

function formatDate(d: Date | string): string {
    const parsed = new Date(d)
    return parsed.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
        timeZone: 'UTC',
    })
}
---

<SiteLayout
    title={`${title} — Writing — Zhifan Chen`}
    description={description}
>
    <main id="main-content" class="py-12 md:py-20">
        <article class="site-container">
            <div class="mb-10">
                <a
                    href="/writing/"
                    class="inline-flex items-center gap-1.5 text-sm font-medium text-muted-foreground hover:text-foreground transition-colors group"
                >
                    <span
                        aria-hidden="true"
                        class="group-hover:-translate-x-0.5 transition-transform"
                        >&larr;</span
                    >
                    <span>Back to all articles</span>
                </a>
            </div>

            <header class="mb-12 max-w-3xl">
                <div class="mb-3">
                    <SectionLabel label="Engineering Notes" />
                </div>

                <h1 class="article__title">
                    {title}
                </h1>

                <p class="article__lede">
                    {description}
                </p>

                <div class="article__meta-line">
                    <time datetime={new Date(publishDate).toISOString()} class="meta-text">
                        {formatDate(publishDate)}
                    </time>
                    {
                        updatedDate && (
                            <span class="meta-text">
                                · UPDATED {formatDate(updatedDate)}
                            </span>
                        )
                    }
                    {
                        tags && tags.length > 0 && (
                            <div class="article__tags">
                                {tags.map((tag: string) => (
                                    <span class="article__tag meta-text">{tag}</span>
                                ))}
                            </div>
                        )
                    }
                </div>
            </header>

            <hr class="my-10 border-border" />

            <div class="article-content prose-column">
                <slot />
            </div>

            <footer class="mt-20 pt-8 border-t border-border flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <ArrowLink href="/writing/">&larr; Back to all articles</ArrowLink>
                <ArrowLink href="/rss.xml" kind="external">Subscribe via RSS</ArrowLink>
            </footer>
        </article>
    </main>
</SiteLayout>

<style is:global>
    .article__title {
        font-size: clamp(2.2rem, 4vw, 3.5rem);
        font-weight: 650;
        line-height: 1.1;
        letter-spacing: -0.03em;
        margin: 1rem 0 1.25rem;
        color: var(--text);
    }

    .article__lede {
        font-size: clamp(1.05rem, 1.4vw, 1.25rem);
        color: var(--text-muted);
        line-height: 1.6;
        margin-bottom: 1.75rem;
    }

    .article__meta-line {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1rem;
        font-family: var(--font-mono);
        font-size: 0.75rem;
    }

    .article__tags {
        display: inline-flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-left: 0.5rem;
    }

    .article__tag {
        display: inline-block;
        padding: 0.1rem 0.45rem;
        border: 1px solid var(--border);
        border-radius: 2px;
        background: var(--surface);
    }

    .article-content {
        color: var(--text);
        line-height: 1.75;
        font-size: 1.05rem;
    }

    .article-content h2 {
        font-size: clamp(1.4rem, 2vw, 1.8rem);
        font-weight: 650;
        letter-spacing: -0.02em;
        margin-top: 3rem;
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid var(--border);
        color: var(--text);
    }

    .article-content h3 {
        font-size: 1.25rem;
        font-weight: 600;
        margin-top: 2rem;
        margin-bottom: 0.75rem;
        color: var(--text);
    }

    .article-content p {
        margin-block: 1.15rem;
        color: color-mix(in srgb, var(--text) 92%, transparent);
    }

    .article-content ul {
        list-style-type: disc;
        margin-block: 1.15rem;
        padding-left: 1.5rem;
    }

    .article-content ol {
        list-style-type: decimal;
        margin-block: 1.15rem;
        padding-left: 1.5rem;
    }

    .article-content li {
        margin-block: 0.4rem;
    }

    .article-content strong {
        font-weight: 600;
        color: var(--text);
    }

    .article-content code:not(pre code) {
        font-family: var(--font-mono);
        font-size: 0.88em;
        background: var(--surface-raised);
        border: 1px solid var(--border);
        padding: 0.15em 0.35em;
        border-radius: 2px;
        color: var(--text);
    }

    .article-content pre {
        margin-block: 1.75rem;
        padding: 1.25rem;
        border: 1px solid var(--border);
        background: var(--surface);
        overflow-x: auto;
        font-family: var(--font-mono);
        font-size: 0.875rem;
        line-height: 1.6;
    }

    .article-content pre code {
        background: transparent;
        border: none;
        padding: 0;
    }

    .article-content blockquote {
        border-left: 3px solid var(--accent);
        padding-left: 1.25rem;
        font-style: italic;
        margin-block: 1.75rem;
        color: var(--text-muted);
    }
</style>
