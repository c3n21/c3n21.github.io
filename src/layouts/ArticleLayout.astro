---
import type { CollectionEntry } from 'astro:content'
import SiteLayout from '@/layouts/SiteLayout.astro'
import Badge from '@/components/Badge.astro'

export interface Props {
    entry: CollectionEntry<'writing'>
}

const { entry } = Astro.props
const { title, description, publishDate, updatedDate, tags } = entry.data

function formatDate(d: Date | string): string {
    const parsed = new Date(d)
    return parsed.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
        timeZone: 'UTC',
    })
}
---

<SiteLayout
    title={`${title} — Writing — Zhifan Chen`}
    description={description}
>
    <main class="py-12 md:py-16">
        <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="mb-8">
                <a
                    href="/writing/"
                    class="inline-flex items-center gap-1.5 text-sm font-medium text-muted-foreground hover:text-foreground transition-colors group"
                >
                    <span
                        aria-hidden="true"
                        class="group-hover:-translate-x-0.5 transition-transform"
                        >&larr;</span
                    >
                    <span>Back to all articles</span>
                </a>
            </div>

            <header class="mb-10 space-y-4">
                <div class="flex items-center gap-2 text-xs font-mono text-muted-foreground">
                    <time datetime={new Date(publishDate).toISOString()}>
                        {formatDate(publishDate)}
                    </time>
                    {
                        updatedDate && (
                            <span>
                                · Updated {formatDate(updatedDate)}
                            </span>
                        )
                    }
                </div>

                <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-foreground">
                    {title}
                </h1>

                <p class="text-lg sm:text-xl text-muted-foreground leading-relaxed">
                    {description}
                </p>

                {
                    tags && tags.length > 0 && (
                        <div class="flex flex-wrap gap-1.5 pt-2">
                            {tags.map((tag) => (
                                <Badge variant="outline" class="text-xs font-mono">
                                    {tag}
                                </Badge>
                            ))}
                        </div>
                    )
                }
            </header>

            <hr class="my-8 border-border/60" />

            <div class="article-content">
                <slot />
            </div>

            <footer class="mt-16 pt-8 border-t border-border flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <a
                    href="/writing/"
                    class="inline-flex items-center gap-1.5 text-sm font-medium text-muted-foreground hover:text-foreground transition-colors"
                >
                    &larr; Back to all articles
                </a>
                <a
                    href="/rss.xml"
                    class="inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:underline underline-offset-4"
                >
                    Subscribe via RSS &rarr;
                </a>
            </footer>
        </article>
    </main>
</SiteLayout>

<style is:global>
    .article-content h2 {
        font-size: 1.5rem;
        line-height: 2rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        margin-top: 2.5rem;
        margin-bottom: 1rem;
        color: hsl(var(--foreground));
        padding-bottom: 0.5rem;
        border-bottom: 1px solid hsl(var(--border) / 0.6);
    }
    .article-content h3 {
        font-size: 1.25rem;
        line-height: 1.75rem;
        font-weight: 600;
        margin-top: 2rem;
        margin-bottom: 0.75rem;
        color: hsl(var(--foreground));
    }
    .article-content p {
        margin-top: 1rem;
        margin-bottom: 1rem;
        line-height: 1.75;
        color: hsl(var(--foreground) / 0.9);
    }
    .article-content ul {
        list-style-type: disc;
        margin-top: 1rem;
        margin-bottom: 1rem;
        padding-left: 1.5rem;
    }
    .article-content ol {
        list-style-type: decimal;
        margin-top: 1rem;
        margin-bottom: 1rem;
        padding-left: 1.5rem;
    }
    .article-content li {
        margin-top: 0.375rem;
        margin-bottom: 0.375rem;
        line-height: 1.625;
        color: hsl(var(--foreground) / 0.9);
    }
    .article-content strong {
        font-weight: 600;
        color: hsl(var(--foreground));
    }
    .article-content code {
        font-family: var(--font-mono);
        font-size: 0.875em;
        background-color: hsl(var(--muted));
        padding: 0.15em 0.35em;
        border-radius: 0.25rem;
        color: hsl(var(--foreground));
    }
    .article-content pre {
        margin-top: 1.5rem;
        margin-bottom: 1.5rem;
        padding: 1.25rem;
        border-radius: 0.5rem;
        overflow-x: auto;
        font-family: var(--font-mono);
        font-size: 0.875rem;
        line-height: 1.6;
        background-color: hsl(var(--muted));
        border: 1px solid hsl(var(--border));
    }
    .article-content pre code {
        background-color: transparent;
        padding: 0;
        border-radius: 0;
    }
    .article-content blockquote {
        border-left: 3px solid hsl(var(--border));
        padding-left: 1rem;
        font-style: italic;
        margin-top: 1.5rem;
        margin-bottom: 1.5rem;
        color: hsl(var(--muted-foreground));
    }
</style>
